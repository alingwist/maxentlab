    given-names: Ali
    affiliation: University of Massachusetts Amherst
version: 1.0.0
date-released: 2026-09-14
license: MIT
repository-code: "https://github.com/alingwist/maxentlab"
url: "https://maxentlab.alinirheche.org"
keywords:
  - phonology
  - Maximum Entropy
  - MaxEnt
  - Harmonic Grammar
  - hidden structure
  - constraint-based grammar
